{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": [
    "gomod",
    "github-actions",
    "nix",
    "custom.regex"
  ],
  "dependencyDashboard": true,
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 5,
  "branchConcurrentLimit": 5,
  "automerge": false,
  "platformAutomerge": false,
  "vulnerabilityAlerts": {
    "enabled": false
  },
  "separateMajorMinor": true,
  "separateMultipleMajor": true,
  "prBodyNotes": [
    "Old and new versions are listed in the update table above. Every affected manifest, lock, workflow, and Nix dependency hash is listed on the pull request Files changed tab. This proposal uses ordinary CI and requires explicit maintainer approval."
  ],
  "packageRules": [
    {
      "description": "Nix owns the compiler and coordinates the module minimum",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang", "toolchain"],
      "enabled": false
    },
    {
      "description": "Update the Go compiler, module minimum and Nix pin together",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["go"],
      "groupName": null,
      "postUpgradeTasks": {
        "commands": ["bash scripts/update-go-toolchain.sh"],
        "fileFilters": ["flake.nix", "flake.lock", "go.mod", "go.sum"],
        "executionMode": "branch"
      }
    },
    {
      "description": "The compiler updater owns the goNixpkgs input",
      "matchManagers": ["nix"],
      "matchDepNames": ["goNixpkgs"],
      "enabled": false
    },
    {
      "description": "Tidy Go manifests and verify the Nix dependency hash",
      "matchManagers": ["gomod"],
      "postUpdateOptions": ["gomodTidy"],
      "postUpgradeTasks": {
        "commands": ["bash scripts/update-go-dependencies.sh"],
        "fileFilters": ["go.mod", "go.sum", "flake.nix"],
        "executionMode": "branch"
      }
    },
    {
      "description": "Group compatible Go updates only with Go updates",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "compatible Go dependencies"
    },
    {
      "description": "Group compatible Actions updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "compatible GitHub Actions"
    },
    {
      "description": "Preserve Actions SHA pins and version comments",
      "matchManagers": ["github-actions"],
      "rangeStrategy": "pin"
    },
    {
      "description": "Group compatible native Nix updates without mixing security data",
      "matchManagers": ["nix"],
      "matchPackageNames": ["!nixpkgs", "!vulndb", "!golang/vulndb"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "compatible Nix dependencies"
    },
    {
      "description": "Keep nixpkgs updates independent",
      "matchManagers": ["nix"],
      "matchPackageNames": ["nixpkgs"],
      "groupName": null
    },
    {
      "description": "Keep vulnerability database updates independent",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["https://github.com/golang/vulndb"],
      "groupName": null,
      "postUpgradeTasks": {
        "commands": ["bash scripts/update-vulndb-dependencies.sh"],
        "fileFilters": ["flake.nix", "flake.lock"],
        "executionMode": "update"
      }
    },
    {
      "description": "Avoid duplicate native Nix proposals for the explicit vulndb revision",
      "matchManagers": ["nix"],
      "matchPackageNames": ["vulndb", "golang/vulndb"],
      "enabled": false
    },
    {
      "description": "Isolate every major and require dashboard approval",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "groupName": null
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The exact Go compiler supplied by Nix",
      "managerFilePatterns": ["/^flake\\.nix$/"],
      "matchStrings": [
        "goVersion = \"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\";"
      ],
      "depNameTemplate": "go",
      "datasourceTemplate": "golang-version",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Fallback only for the explicit vulndb commit in flake.nix",
      "managerFilePatterns": ["/^flake\\.nix$/"],
      "matchStrings": [
        "url\\s*=\\s*\"github:golang/vulndb/(?<currentDigest>[0-9a-f]{40})\";"
      ],
      "currentValueTemplate": "master",
      "depNameTemplate": "golang/vulndb",
      "packageNameTemplate": "https://github.com/golang/vulndb",
      "datasourceTemplate": "git-refs"
    }
  ]
}
